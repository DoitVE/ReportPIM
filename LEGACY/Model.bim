                "    #\"Rimosse colonne\" = Table.RemoveColumns(#\"Ultime righe rimosse\",{\"Column2\", \"Column5\", \"Column6\", \"Column8\", \"Column9\", \"Column12\", \"Column13\", \"Column15\", \"Column23\"}),",
                "    #\"Righe vuote rimosse\" = Table.SelectRows(#\"Rimosse colonne\", each not List.IsEmpty(List.RemoveMatchingItems(Record.FieldValues(_), {\"\", null}))),",
                "    #\"Filtrate righe\" = Table.SelectRows(#\"Righe vuote rimosse\", each not Text.Contains([Column20], \"N.PUNTO DI\") and not Text.Contains([Column20], \"MISURA\")),",
                "    #\"Rinominate colonne\" = Table.RenameColumns(#\"Filtrate righe\",{{\"Column1\", \"Data scoperta\"}, {\"Column3\", \"Cod. linea\"}, {\"Column4\", \"Cod. SeTe\"}, {\"Column7\", \"Bin.\"}, {\"Column10\", \"Fila\"}, {\"Column11\", \"km linea\"}, {\"Column14\", \"Tipo difetto\"}, {\"Column16\", \"Classe porvv.\"}, {\"Column17\", \"Tolto d'opera\"}, {\"Column18\", \"Data tolto d'opera\"}, {\"Column19\", \"Centro di lavoro\"}, {\"Column20\", \"Pdm\"}, {\"Column21\", \"N. doc. di misura\"}, {\"Column22\", \"Avviso\"}}),",
