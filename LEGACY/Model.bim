        "partitions": [
          {
            "name": "IW67",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origine = Excel.Workbook(File.Contents(\"C:\\Users\\952192\\OneDrive - Gruppo Ferrovie Dello Stato\\AMPC\\006 MONITORAGGI\\DIFFETTI ARMAMENTO\\REPORT\\02 Base dati report\\IW67.XLSX\"), null, true),",
                "    Data_Sheet = Origine{[Item=\"Data\",Kind=\"Sheet\"]}[Data],",
                "    #\"Modificato tipo2\" = Table.TransformColumnTypes(Data_Sheet,{{\"Column1\", type text}, {\"Column2\", type text}, {\"Column3\", type text}, {\"Column4\", type text}, {\"Column5\", type text}, {\"Column6\", type text}, {\"Column7\", type text}, {\"Column8\", type text}, {\"Column9\", type text}, {\"Column10\", type text}, {\"Column11\", type text}, {\"Column12\", type text}, {\"Column13\", type text}, {\"Column14\", type text}, {\"Column15\", type text}, {\"Column16\", type text}, {\"Column17\", type text}, {\"Column18\", type text}, {\"Column19\", type text}, {\"Column20\", type text}, {\"Column21\", type text}, {\"Column22\", type text}, {\"Column23\", type text}, {\"Column24\", type any}}),",
                "    #\"Rimosse prime righe\" = Table.Skip(#\"Modificato tipo2\",4),",
                "    #\"Righe vuote rimosse\" = Table.SelectRows(#\"Rimosse prime righe\", each not List.IsEmpty(List.RemoveMatchingItems(Record.FieldValues(_), {\"\", null}))),",
                "    #\"Intestazioni alzate di livello\" = Table.PromoteHeaders(#\"Righe vuote rimosse\", [PromoteAllScalars=true]),",
                "    #\"Modificato tipo\" = Table.TransformColumnTypes(#\"Intestazioni alzate di livello\",{{\"Avviso\", Int64.Type}, {\"Ordine\", Int64.Type}, {\"Definizione della sede tecnica\", type text}, {\"Tp.\", type text}, {\"Codice\", type text}, {\"Testo per la misura\", type text}, {\"Testo codice per misura\", type text}, {\"Data\", type date}, {\"Descrizione\", type text}, {\"Latit iniz\", Int64.Type}, {\"Long inizi\", Int64.Type}, {\"CLavResp\", type text}, {\"CD\", type text}, {\"Data rif.\", type date}, {\"DataEsec.\", type date}, {\"In. pian.\", type date}, {\"Mod. il\", type date}, {\"Data cr.\", type date}, {\"Fine pian.\", type date}, {\"FineRich.\", type date}, {\"Sede tecnica\", type text}, {\"ST cons.\", type text}, {\"St.sist.\", type text}}),",
                "    #\"Sostituito valore\" = Table.ReplaceValue(#\"Modificato tipo\",\" \",\"\",Replacer.ReplaceText,{\"Testo per la misura\"}),",
                "    #\"Suddividi colonna in base al delimitatore\" = Table.SplitColumn(#\"Sostituito valore\", \"Testo per la misura\", Splitter.SplitTextByDelimiter(\"Val.\", QuoteStyle.Csv), {\"Testo per la misura.1\", \"Testo per la misura.2\"}),",
                "    #\"Modificato tipo1\" = Table.TransformColumnTypes(#\"Suddividi colonna in base al delimitatore\",{{\"Testo per la misura.1\", type text}, {\"Testo per la misura.2\", type number}}),",
                "    #\"Rinominate colonne\" = Table.RenameColumns(#\"Modificato tipo1\",{{\"Testo per la misura.1\", \"Km.\"}, {\"Testo per la misura.2\", \"Val.\"}}),",
                "    #\"Duplicata colonna\" = Table.DuplicateColumn(#\"Rinominate colonne\", \"Sede tecnica\", \"Sede tecnica - Copia\"),",
                "    #\"Testo estratto prima del delimitatore\" = Table.TransformColumns(#\"Duplicata colonna\", {{\"Sede tecnica - Copia\", each Text.BeforeDelimiter(_, \"-\"), type text}}),",
                "    #\"Rinominate colonne1\" = Table.RenameColumns(#\"Testo estratto prima del delimitatore\",{{\"Sede tecnica - Copia\", \"SeTe primo livello\"}}),",
                "    #\"Aggiunta colonna personalizzata\" = Table.AddColumn(#\"Rinominate colonne1\", \"Personalizzato\", each Date.Year([Data])),",
                "    #\"Filtrate righe\" = Table.SelectRows(#\"Aggiunta colonna personalizzata\", each [Personalizzato] > 2021),",
                "    #\"Rinominate colonne2\" = Table.RenameColumns(#\"Filtrate righe\",{{\"Personalizzato\", \"Anno avviso\"}}),",
                "    #\"Caratteri iniziali estratti\" = Table.TransformColumns(#\"Rinominate colonne2\", {{\"Sede tecnica\", each Text.Start(_, 14), type text}}),",
                "    #\"Rinominate colonne3\" = Table.RenameColumns(#\"Caratteri iniziali estratti\",{{\"FineRich.\", \"Data Fine Richiesta\"}, {\"Testo codice per misura\", \"Testo\"}}),",
                "    #\"Aggiunta colonna personalizzata1\" = Table.AddColumn(#\"Rinominate colonne3\", \"Personalizzato\", each Date.QuarterOfYear([Data])),",
                "    #\"Aggiunta colonna personalizzata2\" = Table.AddColumn(#\"Aggiunta colonna personalizzata1\", \"Personalizzato.1\", each if [#\"St.sist.\"]=\"MISC\" then \"CHIUSO\" else if",
                "[Data Fine Richiesta]<Date.From(DateTime.LocalNow()) then \"SCADUTO\" else if [Data Fine Richiesta]<Date.AddDays(Date.From(DateTime.LocalNow()), 10) then \"SCAD.<10GG\" else if [Data Fine Richiesta]<Date.AddDays(Date.From(DateTime.LocalNow()), 30) then \"SCAD.<30GG\" else if  [Data Fine Richiesta]<Date.AddDays(Date.From(DateTime.LocalNow()), 60) then \"SCAD.<60GG\" else \"SCAD.>60GG\"),",
                "    #\"Rinominate colonne4\" = Table.RenameColumns(#\"Aggiunta colonna personalizzata2\",{{\"Personalizzato.1\", \"Stato\"}, {\"Tp.\", \"Tipo\"}, {\"St.sist.\", \"Stato sist.\"}}),",
                "    #\"Testo inserito prima del delimitatore\" = Table.AddColumn(#\"Rinominate colonne4\", \"Testo prima del delimitatore\", each Text.BeforeDelimiter([#\"Km.\"], \",\"), type text),",
                "    #\"Rinominate colonne5\" = Table.RenameColumns(#\"Testo inserito prima del delimitatore\",{{\"Testo prima del delimitatore\", \"Km. rif.\"}, {\"Val.\", \"Val. difetto\"}}),",
                "    #\"Aggiunta colonna personalizzata3\" = Table.AddColumn(#\"Rinominate colonne5\", \"Km inizio\", each Text.BeforeDelimiter([#\"Km.\"], \"-\")),",
                "    #\"Aggiunta colonna personalizzata4\" = Table.AddColumn(#\"Aggiunta colonna personalizzata3\", \"Km fine\", each Text.AfterDelimiter([#\"Km.\"], \"-\")),",
                "    #\"Rinominate colonne6\" = Table.RenameColumns(#\"Aggiunta colonna personalizzata4\",{{\"Personalizzato\", \"Trimestre\"}}),",
                "    #\"Aggiunta colonna personalizzata5\" = Table.AddColumn(#\"Rinominate colonne6\", \"Cod. Stato\", each if [#\"Stato sist.\"]=\"MISC\" then 2 else if",
                "[Data Fine Richiesta]<Date.From(DateTime.LocalNow()) then 1 else if [Data Fine Richiesta]<Date.AddDays(Date.From(DateTime.LocalNow()), 10) then 3 else if [Data Fine Richiesta]<Date.AddDays(Date.From(DateTime.LocalNow()), 30) then 4 else if  [Data Fine Richiesta]<Date.AddDays(Date.From(DateTime.LocalNow()), 60) then 5 else 6)",
                "in",
                "    #\"Aggiunta colonna personalizzata5\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigazione"
          },
