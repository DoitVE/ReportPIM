            "name": "IH06",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origine = Excel.Workbook(File.Contents(\"C:\\Users\\952192\\OneDrive - Gruppo Ferrovie Dello Stato\\AMPC\\006 MONITORAGGI\\DIFFETTI ARMAMENTO\\REPORT\\02 Base dati report\\IH06.XLSX\"), null, true),",
                "    Sheet1_Sheet = Origine{[Item=\"Sheet1\",Kind=\"Sheet\"]}[Data],",
                "    #\"Intestazioni alzate di livello\" = Table.PromoteHeaders(Sheet1_Sheet, [PromoteAllScalars=true]),",
                "    #\"Modificato tipo\" = Table.TransformColumnTypes(#\"Intestazioni alzate di livello\",{{\"Sede tecnica\", type text}, {\"Definizione della sede tecnica\", type text}, {\"Divis. ubic.\", type text}, {\"Stato sistema\", type text}, {\"Stato utente\", type text}, {\"Km. Inizio\", type number}, {\"Km. Fine\", type number}, {\"Data modifica\", type date}, {\"Autore modifica\", type text}, {\"Centro di lavoro\", type text}, {\"Località\", type text}, {\"In funz. dal\", type date}, {\"Data creazione\", type date}, {\"Divisione pian.\", type text}, {\"Lunghezza\", type text}, {\"Sede tecnica di riferimento\", type text}, {\"Telefono\", type text}, {\"Centro lavoro resp.\", type text}, {\"Tipo di oggetto\", type text}, {\"Sistema d'identif.\", type text}, {\"Altezza minima L.d.C. [m]\", type number}, {\"Autore dell'ultima modifica\", type text}, {\"Base assoluta\", type text}, {\"Binario\", type text}, {\"Binario AV/AC\", type text}, {\"Binario Allegato VI.12\", type text}, {\"Binario elettrificato\", type text}, {\"Classe linea per vigilanza\", Int64.Type}, {\"Codice binario SAS\", type text}, {\"Data dell'ultima modifica\", Int64.Type}, {\"Div. pian. della manutenzione\", type text}, {\"Intercon. circol. da treni\", type text}, {\"Interconnessione\", type text}, {\"Linea di appartenenza\", type text}, {\"Lungh. di stazionamento [m]\", Int64.Type}, {\"Lunghezza del binario [Km]\", type number}, {\"Monitoraggio Carico Dinamico\", type text}, {\"Monitoraggio temp. rotaia\", type text}, {\"Presenza Raccordo in Tratta\", type text}, {\"Profilo Manutentivo L94 (BC)\", type text}, {\"Progr. Km monitoraggio temp.\", type number}, {\"Progr. Km. altezza min. L.d.C.\", type number}, {\"Sent. percorribile piedi\", type text}, {\"Tipo L.d.C.\", type text}, {\"Velocità Rango A\", Int64.Type}, {\"Velocità Rango B\", Int64.Type}, {\"Velocità Rango C\", Int64.Type}, {\"Velocità Rango P\", Int64.Type}, {\"n. Regolazioni Automatiche\", Int64.Type}, {\"n. dev. manovr. mano centr.\", Int64.Type}, {\"n. deviatoi elettrici\", Int64.Type}, {\"n. di sezioni marcia DX\", Int64.Type}, {\"n. di sezioni marcia SX\", Int64.Type}, {\"n. passatoie\", Int64.Type}, {\"n. tot deviatoi/inters. centr.\", Int64.Type}}),",
                "    #\"Rinominate colonne\" = Table.RenameColumns(#\"Modificato tipo\",{{\"Binario\", \"Bin.\"}})",
                "in",
